<%- include('header') %>

<div class="page-wrapper">
  <!-- Modern Page Header -->
  <div class="page-header d-print-none bg-gradient-to-r from-primary-50 to-blue-50">
    <div class="container-xl">
      <div class="row g-2 align-items-center animate-fade-in-up">
        <div class="col">
          <div class="page-pretitle text-primary-600">
            Overview
          </div>
          <h2 class="page-title text-gray-900 font-bold">
            Dashboard
          </h2>
        </div>
        <div class="col-auto ms-auto d-print-none">
          <div class="btn-list">
            <a href="/sell" class="btn btn-primary btn-modern">
              <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M12 5l0 14"/>
                <path d="M5 12l14 0"/>
              </svg>
              New Sale
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modern Dashboard Content -->
  <div class="page-body">
    <div class="container-xl">
      <div class="row row-deck row-cards">
        
        <!-- Modern Stats Cards -->
        <div class="col-sm-6 col-lg-3">
          <div class="card animate-fade-in-up" style="animation-delay: 0.1s">
            <div class="card-body">
              <div class="d-flex align-items-center">
                <div class="subheader text-primary-600">Today's Sales</div>
                <div class="ms-auto">
                  <span class="bg-primary-100 text-primary-700 badge">Live</span>
                </div>
              </div>
              <div class="h1 mb-3 text-gray-900">₦75,000</div>
              <div class="d-flex mb-2">
                <div class="text-gray-600">Total Revenue</div>
                <div class="ms-auto">
                  <span class="text-green-600 d-inline-flex align-items-center lh-1">
                    12%
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon ms-1" width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M3 17l6 -6l4 4l8 -8"/>
                      <path d="M14 7l7 0l0 7"/>
                    </svg>
                  </span>
                </div>
              </div>
              <div class="progress progress-sm">
                <div class="progress-bar bg-gradient-to-r from-primary-500 to-primary-600" style="width: 75%" role="progressbar">
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-sm-6 col-lg-3">
          <div class="card animate-fade-in-up" style="animation-delay: 0.2s">
            <div class="card-body">
              <div class="d-flex align-items-center">
                <div class="subheader text-primary-600">Products Sold</div>
              </div>
              <div class="h1 mb-3 text-gray-900">142</div>
              <div class="d-flex mb-2">
                <div class="text-gray-600">Items Today</div>
                <div class="ms-auto">
                  <span class="text-green-600">+8%</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-sm-6 col-lg-3">
          <div class="card animate-fade-in-up" style="animation-delay: 0.3s">
            <div class="card-body">
              <div class="d-flex align-items-center">
                <div class="subheader text-primary-600">Active Users</div>
              </div>
              <div class="h1 mb-3 text-gray-900">24</div>
              <div class="d-flex mb-2">
                <div class="text-gray-600">Online Now</div>
                <div class="ms-auto">
                  <span class="text-blue-600">Live</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-sm-6 col-lg-3">
          <div class="card animate-fade-in-up" style="animation-delay: 0.4s">
            <div class="card-body">
              <div class="d-flex align-items-center">
                <div class="subheader text-primary-600">Low Stock</div>
              </div>
              <div class="h1 mb-3 text-orange-600">5</div>
              <div class="d-flex mb-2">
                <div class="text-gray-600">Items Need Restock</div>
                <div class="ms-auto">
                  <span class="text-orange-600">Alert</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-12">
          <div class="card animate-fade-in-up" style="animation-delay: 0.5s">
            <div class="card-header">
              <h3 class="card-title text-gray-900">Quick Actions</h3>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                  <a href="/sell" class="btn btn-primary btn-modern w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg mb-2" width="32" height="32" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M6 19m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/>
                      <path d="M17 19m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/>
                      <path d="M17 17h-11v-14h-2"/>
                      <path d="M6 5l14 1l-1 7h-13"/>
                    </svg>
                    <span class="font-semibold">New Sale</span>
                  </a>
                </div>
                <div class="col-sm-6 col-lg-3">
                  <a href="/eventoverview" class="btn btn-outline-primary btn-modern w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg mb-2" width="32" height="32" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5"/>
                      <path d="M12 12l8 -4.5"/>
                      <path d="M12 12l0 9"/>
                      <path d="M12 12l-8 -4.5"/>
                    </svg>
                    <span class="font-semibold">Products</span>
                  </a>
                </div>
                <div class="col-sm-6 col-lg-3">
                  <a href="/saleshistory" class="btn btn-outline-primary btn-modern w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg mb-2" width="32" height="32" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M3 17l6 -6l4 4l8 -8"/>
                      <path d="M14 7l7 0l0 7"/>
                    </svg>
                    <span class="font-semibold">Sales History</span>
                  </a>
                </div>
                <div class="col-sm-6 col-lg-3">
                  <a href="/users" class="btn btn-outline-primary btn-modern w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg mb-2" width="32" height="32" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/>
                      <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                      <path d="M21 21v-2a4 4 0 0 0 -3 -3.85"/>
                    </svg>
                    <span class="font-semibold">Users</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('footer') %>