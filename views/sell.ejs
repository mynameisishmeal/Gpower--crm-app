            <script>
  document.querySelectorAll('.payment-method-checkbox').forEach(function(checkbox) {
    checkbox.addEventListener('change', function() {
      var input = document.querySelector('.payment-amount-input[data-method="' + checkbox.value + '"]');
      if (checkbox.checked) {
        input.style.display = 'inline-block';
        input.disabled = false;
        input.value = ''; // Make it empty when checked
      } else {
        input.style.display = 'none';
        input.disabled = true;
        input.value = ''; // Make it empty when unchecked
      }
    });
  });
</script>
