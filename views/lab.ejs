<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bluetooth Service and Characteristic Discovery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <button id="discoverButton" class="btn btn-primary">Discover Bluetooth Services and Characteristics</button>
        <div id="output" class="mt-3"></div>
    </div>
    
    <script>
        async function discoverServicesAndCharacteristics(device) {
            try {
                const server = await device.gatt.connect();
                const services = await server.getPrimaryServices();
                const outputDiv = document.getElementById("output");
                outputDiv.innerHTML = ""; // Clear previous content

                const servicesList = document.createElement("ul");
                servicesList.classList.add("list-group");
                outputDiv.appendChild(servicesList);

                console.log(`Services found on ${device.name}:`);

                for (const service of services) {
                    const serviceItem = document.createElement("li");
                    serviceItem.classList.add("list-group-item", "list-group-item-action");
                    serviceItem.textContent = `Service UUID: ${service.uuid}`;
                    servicesList.appendChild(serviceItem);

                    const characteristics = await service.getCharacteristics();

                    console.log(`Service UUID: ${service.uuid}`);
                    
                    const characteristicsList = document.createElement("ul");
                    characteristicsList.classList.add("list-group", "list-group-flush");
                    serviceItem.appendChild(characteristicsList);

                    for (const characteristic of characteristics) {
                        const characteristicItem = document.createElement("li");
                        characteristicItem.classList.add("list-group-item");
                        characteristicItem.textContent = `Characteristic UUID: ${characteristic.uuid}`;
                        characteristicsList.appendChild(characteristicItem);

                        console.log(`\tCharacteristic UUID: ${characteristic.uuid}`);
                    }
                }

                await server.disconnect();
            } catch (error) {
                console.error('Error:', error);
            }
        }

        document.getElementById('discoverButton').addEventListener('click', async () => {
            try {
                const device = await navigator.bluetooth.requestDevice({
                    acceptAllDevices: true,
                    optionalServices: []
                });
                console.log('Device:', device.name);
                await discoverServicesAndCharacteristics(device);
            } catch (error) {
                console.error('Error:', error);
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.min.js"></script>
</body>
</html>
