  <!-- Web Serial thermal printing helper (safe, global) -->
  <script>
  (function () {
    async function printWithWebSerial(formattedText, opts) {
      const options = Object.assign({
        // Default: no filters so Chrome shows all serial-capable devices
        vendorFilters: [],
        baudRate: 9600,
        feedLines: 3,
        cut: true,
      }, opts || {});

      if (!('serial' in navigator)) {
        throw new Error('Web Serial API not supported. Use Chrome over HTTPS.');
      }

      const requestOpts = {};
      if (Array.isArray(options.vendorFilters) && options.vendorFilters.length) {
        requestOpts.filters = options.vendorFilters;
      }
      const port = await navigator.serial.requestPort(requestOpts);
      await port.open({ baudRate: options.baudRate, dataBits: 8, stopBits: 1, parity: 'none', flowControl: 'none' });

      const writer = port.writable.getWriter();
      const enc = new TextEncoder();

      // Initialize, left align, normal size
      await writer.write(enc.encode('\x1B\x40'));
      await writer.write(enc.encode('\x1B\x61\x00'));
      await writer.write(enc.encode('\x1D\x21\x00'));

      // Normalize newlines and print line by line
      const text = String(formattedText || '').replace(/\r\n?/g, '\n');
      const lines = text.split('\n');
      for (let i = 0; i < lines.length; i++) {
        await writer.write(enc.encode(lines[i] + '\n'));
      }

      if (options.feedLines > 0) {
        await writer.write(enc.encode('\n'.repeat(options.feedLines)));
      }
      if (options.cut) {
        await writer.write(enc.encode('\x1D\x56\x00'));// partial cut (if supported)
      }

      writer.releaseLock();
      await port.close();
      return true;
    }

    // Expose globally for use after calling /generate-pdf-receipt
    window.printWithWebSerial = printWithWebSerial;
  })();
  </script>
