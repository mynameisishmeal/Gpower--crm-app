    <!-- Tabler Core -->   <script>
// Check printer type and update header status
function updatePrinterStatus() {
  const printerType = localStorage.getItem('printerType') || 'wireless';
  const connectButton = document.getElementById('connectButton');
  const statusText = document.getElementById('printerStatusText');
  const connectionStatus = document.getElementById('connectionStatus');
  
  // Only update if elements exist (user is logged in)
  if (!connectButton || !connectionStatus) return;
  
  if (printerType === 'wired') {
    const printerName = localStorage.getItem('wiredPrinterName') || 'Unknown';
    // Change icon to wired printer icon
    connectButton.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-printer">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" />
        <path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" />
        <path d="M7 13m0 2a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2z" />
      </svg>
      <span id="printerStatusText">Wired: ${printerName}</span>
    `;
    connectButton.disabled = true; // Disable click for wired mode
    connectionStatus.textContent = 'Wired Printer Mode';
    connectionStatus.style.color = 'green';
  } else {
    // Keep original Bluetooth icon and functionality
    connectButton.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-bluetooth">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M7 8l10 8l-5 4l0 -16l5 4l-10 8" />
      </svg>
      <span id="printerStatusText">Connect</span>
    `;
    connectButton.disabled = false;
    connectionStatus.textContent = ''; // Will be updated by Bluetooth connection logic
  }
}

// Run on page load
document.addEventListener('DOMContentLoaded', function() {
  setTimeout(updatePrinterStatus, 100); // Small delay to ensure elements are loaded
});

// Listen for storage changes (when settings are updated)
window.addEventListener('storage', updatePrinterStatus);

// Also listen for manual trigger
window.addEventListener('printerTypeChanged', updatePrinterStatus);

// Override any Bluetooth status updates if in wired mode
setInterval(function() {
  const printerType = localStorage.getItem('printerType') || 'wireless';
  if (printerType === 'wired') {
    updatePrinterStatus(); // Re-apply wired status every 2 seconds
  }
}, 2000);
</script>
