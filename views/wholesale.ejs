        }
    }
    
    // 2. Test data collection
    console.log('\n📊 Testing data collection...');
    testDataCollection();
    
    // 3. Test inventory endpoint
    console.log('\n🔧 Testing inventory endpoint...');
    testInventoryUpdate();
    
    console.log('=== END COMPREHENSIVE DEBUG ===');
};

window.testDataCollection = function() {
    const table = document.getElementById('dataTable');
    const data = [];
    
    if (table && table.rows.length > 1) {
        for (let i = 1; i < table.rows.length; i++) {
            const row = table.rows[i];
            const qtyDisplay = row.querySelector('.qty-display');
            
            let quantity;
            if (qtyDisplay) {
                quantity = parseFloat(qtyDisplay.textContent.trim()).toString();
                console.log(`✅ Collected quantity from display: ${quantity}`);
            } else {
                quantity = row.cells[2].textContent.replace(/[^\d.]/g, '');
                console.log(`⚠️ Collected quantity from cell: ${quantity}`);
            }
            
            const rowData = {
                Column0: row.cells[0].textContent.trim(),
                Column1: row.cells[1].textContent.trim(),
                Column2: quantity,
                Column3: row.cells[3].textContent.trim()
            };
            
            console.log('📦 Row data:', rowData);
            data.push(rowData);
        }
    }
    
    console.log('📊 Final collected data:', data);
    return data;
};

// **TEST ACTUAL INVENTORY CALL WITH CURRENT DATA**
window.testCurrentInventory = function() {
    const data = testDataCollection();
    
    if (data.length === 0) {
        console.log('❌ No data to test');
        return;
    }
    
    console.log('🧪 Testing inventory update with current cart data...');
    
    $.ajax({
        type: 'POST',
        url: '/updateInventory',
        data: { salesData: data },
        dataType: 'json',
        success: function(response) {
            console.log('✅ Current inventory test SUCCESS:', response);
            alert('✅ Inventory update would work with current cart!');
        },
        error: function(xhr, status, error) {
            console.error('❌ Current inventory test FAILED:', {
                status: xhr.status,
                error: error,
                response: xhr.responseText
            });
            alert(`❌ Inventory update would fail: ${xhr.status} - ${error}`);
        }
    });
};
</script>
  </body>
</html>