      body {
  font-family: Arial, sans-serif;
  background-color: #f0f0f0;
  margin: 0;
  padding: 0;
}



.xin-container {
      /* max-width: 600px; */
      width: 100%;
      background-color: transparent;
      /* padding: 20px; */
      border-radius: 8px;
      /* box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); */
      display: inline-flexbox;
      margin-left: auto;
      flex-direction: column;
      font-size: small;
      align-items:first baseline;
    }

    .xin-h1 {
      text-align: center;
      /* margin-bottom: 20px; */
    }


    .xin-label {
      font-weight: bold;
      margin-right: 10px; /* Add space between label and input/select */
    }

    .xin-input[type="text"],
    .xin-input[type="date"],
    .xin-select {
      /* flex: 0;  */
      padding: 8px;
      font-size: 16px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

    .xin-button {
      background-color:  #206bc4;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
      /* margin-left: auto; */
    }

    .xin-button:hover {
      background-color: #45a049;
    }

    .xin-searchResults {
      margin-top: 20px;
    }






