<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
    <title>Sign Up - Gpower Frozen Foods</title>
    <!-- CSS files -->
    <link href="css/tabler.min.css?1684106062" rel="stylesheet"/>
    <link href="css/tabler-flags.min.css?1684106062" rel="stylesheet"/>
    <link href="css/tabler-payments.min.css?1684106062" rel="stylesheet"/>
    <link href="css/tabler-vendors.min.css?1684106062" rel="stylesheet"/>
    <link href="css/demo.min.css?1684106062" rel="stylesheet"/>
    
    <style>
      @import url('https://rsms.me/inter/inter.css');
      :root {
        --tblr-font-sans-serif: 'Inter Var', -apple-system, BlinkMacSystemFont, San Francisco, Segoe UI, Roboto, Helvetica Neue, sans-serif;
      }
      body {
        font-feature-settings: "cv03", "cv04", "cv11";
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
      }
      .signup-card {
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border: none;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
      }
      .form-control {
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        padding: 0.75rem;
        transition: all 0.2s ease;
      }
      .form-control:focus {
        border-color: #206bc4;
        box-shadow: 0 0 0 3px rgba(32, 107, 196, 0.1);
      }
      .btn-primary {
        background: linear-gradient(135deg, #206bc4 0%, #1a5aa0 100%);
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s ease;
      }
      .btn-primary:hover {
        background: linear-gradient(135deg, #1a5aa0 0%, #144d87 100%);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(32, 107, 196, 0.4);
      }
      .form-label {
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 0.5rem;
      }
      .card-header {
        background: linear-gradient(135deg, #206bc4 0%, #1a5aa0 100%);
        color: white;
        border-radius: 12px 12px 0 0 !important;
        text-align: center;
        padding: 2rem;
      }
      .card-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
      }
      .form-section {
        background: #f8fafc;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border-left: 4px solid #206bc4;
      }
      .section-title {
        color: #206bc4;
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .form-select {
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        padding: 0.75rem;
        transition: all 0.2s ease;
      }
      .form-select:focus {
        border-color: #206bc4;
        box-shadow: 0 0 0 3px rgba(32, 107, 196, 0.1);
      }
      .radio-group {
        display: flex;
        gap: 1rem;
        margin-top: 0.5rem;
      }
      .radio-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .radio-item:hover {
        border-color: #206bc4;
        background: #f1f5f9;
      }
      .radio-item input:checked + .radio-label {
        color: #206bc4;
        font-weight: 600;
      }
      .radio-item:has(input:checked) {
        border-color: #206bc4;
        background: rgba(32, 107, 196, 0.1);
      }
      .footer-links {
        text-align: center;
        margin-top: 2rem;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 8px;
      }
      .footer-links a {
        color: #206bc4;
        text-decoration: none;
        font-weight: 600;
        margin: 0 0.5rem;
      }
      .footer-links a:hover {
        text-decoration: underline;
      }
      .input-group-text {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0 8px 8px 0;
      }
    </style>
  </head>
  
  <body class="d-flex flex-column">
    <script src="js/demo-theme.min.js?1684106062"></script>
    <%- include('header') %>
    <div class="page page-center">
      <div class="container py-4">
        <div class="row justify-content-center">
          <div class="col-md-10 col-lg-8">
            
            <form class="card signup-card" id="form" method="post" enctype="multipart/form-data">
              <!-- Header -->
              <div class="card-header">
                <h2 class="card-title">
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="m22 21-3-3m1 4a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                  </svg>
                  Create New Account
                </h2>
                <p class="mb-0 mt-2 opacity-75">Join Gpower Frozen Foods Team</p>
              </div>

              <div class="card-body">
                <input name="utf8" type="hidden" value="✓">
                <input type="hidden" value="" name="ref">
                <div id="error_explanation" class="ghost"></div>

                <!-- Personal Information Section -->
                <div class="form-section">
                  <div class="section-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                      <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Personal Information
                  </div>
                  
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label class="form-label">First Name *</label>
                      <input class="form-control" placeholder="Enter first name" autocomplete="off" type="text" name="firstname" id="user_first_name" required>
                    </div>
                    <div class="col-md-6 mb-3">
                      <label class="form-label">Last Name *</label>
                      <input class="form-control" placeholder="Enter last name" autocomplete="off" type="text" name="lastname" id="user_last_name" required>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label class="form-label">Email Address *</label>
                      <input type="email" class="form-control" placeholder="Enter email address" autocomplete="off" name="email" id="user_email" required>
                    </div>
                    <div class="col-md-6 mb-3">
                      <label class="form-label">Confirm Email *</label>
                      <input type="email" class="form-control" placeholder="Confirm email address" autocomplete="off" name="emailconfirmation" id="user_email_confirmation" required>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label class="form-label">Password *</label>
                      <input autocomplete="off" class="form-control" placeholder="Create password" type="password" name="password" id="user_password" required>
                    </div>
                    <div class="col-md-6 mb-3">
                      <label class="form-label">Confirm Password *</label>
                      <input autocomplete="off" class="form-control" placeholder="Confirm password" type="password" name="passwordconfirmation" id="user_password_confirmation" required>
                    </div>
                  </div>
                </div>

                <!-- Personal Details Section -->
                <div class="form-section">
                  <div class="section-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                      <path d="m7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    Personal Details
                  </div>

                  <div class="row">
                    <div class="col-md-8 mb-3">
                      <label class="form-label">Date of Birth *</label>
                      <div class="row">
                        <div class="col-4">
                          <select class="form-select" name="birthday" id="user_profile_attributes_birth_day" required>
                            <option value="">Day</option>
                            <% for(let i = 1; i <= 31; i++) { %>
                              <option value="<%= i %>"><%= i %></option>
                            <% } %>
                          </select>
                        </div>
                        <div class="col-4">
                          <select class="form-select" name="birthmonth" id="user_profile_attributes_birth_month" required>
                            <option value="">Month</option>
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                          </select>
                        </div>
                        <div class="col-4">
                          <select class="form-select" name="birthyear" id="user_profile_attributes_birth_year" required>
                            <option value="">Year</option>
                            <% for(let i = 2024; i >= 1950; i--) { %>
                              <option value="<%= i %>"><%= i %></option>
                            <% } %>
                          </select>
                        </div>
                      </div>
                    </div>
                    <div class="col-md-4 mb-3">
                      <label class="form-label">Gender *</label>
                      <div class="radio-group">
                        <div class="radio-item">
                          <input type="radio" value="male" name="gender" id="gender_male" required>
                          <label class="radio-label" for="gender_male">Male</label>
                        </div>
                        <div class="radio-item">
                          <input type="radio" value="female" name="gender" id="gender_female" required>
                          <label class="radio-label" for="gender_female">Female</label>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Location Section -->
                <div class="form-section">
                  <div class="section-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    Location Information
                  </div>

                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label class="form-label">Country *</label>
                      <select class="form-select" name="country" id="user_profile_attributes_country" required>
                        <option value="NG" selected>Nigeria</option>
                        <option value="GB">United Kingdom</option>
                        <option value="US">United States</option>
                        <option disabled>---------------</option>
                        <option value="GH">Ghana</option>
                        <option value="KE">Kenya</option>
                        <option value="ZA">South Africa</option>
                        <!-- Add more countries as needed -->
                      </select>
                    </div>
                    <div class="col-md-6 mb-3">
                      <label class="form-label">City *</label>
                      <input class="form-control" placeholder="Enter city" value="Lagos" type="text" name="city" id="user_profile_attributes_city" required>
                    </div>
                  </div>
                </div>

                <!-- Contact Section -->
                <div class="form-section">
                  <div class="section-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    Contact Information
                  </div>

                  <div class="row">
                    <div class="col-md-4 mb-3">
                      <label class="form-label">Country Code</label>
                      <select class="form-select" name="countrycode" id="user_country_code">
                        <option value="NG" selected>NG +234</option>
                        <option value="GB">GB +44</option>
                        <option value="US">US +1</option>
                        <option value="GH">GH +233</option>
                        <!-- Add more country codes as needed -->
                      </select>
                    </div>
                    <div class="col-md-8 mb-3">
                      <label class="form-label">Phone Number</label>
                      <input autocomplete="off" class="form-control" placeholder="Enter phone number" type="text" name="phonenumber" id="user_phone_number">
                    </div>
                  </div>
                </div>

                <!-- Role Section -->
                <div class="form-section">
                  <div class="section-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                      <circle cx="9" cy="7" r="4"/>
                      <path d="m22 21-3-3m1 4a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                    </svg>
                    System Role
                  </div>

                  <div class="row">
                    <div class="col-12 mb-3">
                      <label class="form-label">User Role *</label>
                      <select class="form-select" name="role" id="user_role" required>
                        <option value="">Select Role</option>
                        <% if(data.role == superadminidentity){ %>
                          <option value="admin">Administrator</option>
                          <option value="worker">Worker</option>
                          <option value="sadmin">Super Administrator</option>
                        <% } else { %>
                          <option value="worker">Worker</option>
                        <% } %>
                      </select>
                    </div>
                  </div>
                </div>

                <!-- Submit Button -->
                <div class="form-footer mt-4">
                  <button type="submit" class="btn btn-primary w-100">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                      <circle cx="9" cy="7" r="4"/>
                      <path d="m22 21-3-3m1 4a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                    </svg>
                    Create New Account
                  </button>
                </div>
              </div>
            </form>

            <!-- Footer Links -->
            <div class="footer-links">
              <a href="/users">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="m22 21-3-3m1 4a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                </svg>
                View All Users
              </a>
              |
              <a href="/">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  <polyline points="9,22 9,12 15,12 15,22"/>
                </svg>
                Home
              </a><%- include('footer') %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Libs JS -->
    <script src="js/jquery-3.6.0.min.js"></script>
    <script src="js/tabler.min.js?1684106062" defer></script>
    <script src="js/demo.min.js" defer></script>
    <script src="js/toast.js"></script>
    <script src="js/signup.js"></script>
    <script src="js/shared.js"></script>

    <script>
      // Form validation and enhancement
      document.addEventListener('DOMContentLoaded', function() {
        // Email confirmation validation
        const emailInput = document.getElementById('user_email');
        const emailConfirmInput = document.getElementById('user_email_confirmation');
        
        function validateEmail() {
          if (emailInput.value && emailConfirmInput.value) {
            if (emailInput.value !== emailConfirmInput.value) {
              emailConfirmInput.setCustomValidity('Emails do not match');
            } else {
              emailConfirmInput.setCustomValidity('');
            }
          }
        }
        
        emailInput.addEventListener('blur', validateEmail);
        emailConfirmInput.addEventListener('blur', validateEmail);
        
        // Password confirmation validation
        const passwordInput = document.getElementById('user_password');
        const passwordConfirmInput = document.getElementById('user_password_confirmation');
        
        function validatePassword() {
          if (passwordInput.value && passwordConfirmInput.value) {
            if (passwordInput.value !== passwordConfirmInput.value) {
              passwordConfirmInput.setCustomValidity('Passwords do not match');
            } else {
              passwordConfirmInput.setCustomValidity('');
            }
          }
        }
        
        passwordInput.addEventListener('blur', validatePassword);
        passwordConfirmInput.addEventListener('blur', validatePassword);
        
        // Form submission
        document.getElementById('form').addEventListener('submit', function(e) {
          validateEmail();
          validatePassword();
          
          // Check if form is valid
          if (!this.checkValidity()) {
            e.preventDefault();
            showToast('Please fill in all required fields correctly', 'danger');
          }
        });
      });
    </script>
  </body>
</html>