                        </div>
                        <!-- <div class="col-auto"><a href="#" class="btn">
                            Change
                          </a></div> -->
                      </div>
                    </div>
                    <h3 class="card-title mt-4">Password</h3>
                    <p class="card-subtitle">You can set a permanent password if you don't want to use temporary login codes.</p>
                    <div>
                      <!-- <a href="#" class="btn"> -->
                 
                      <div class="col-auto">
                        <input type="text" class="form-control w-auto" value="" placeholder="Current password">
                      </div>
                      
                   
                      <div class="col-auto">
                        <input type="text" class="form-control w-auto" value="" placeholder="New password">
                      </div>


                      <div class="col-auto">
                        <input type="text" class="form-control w-auto" value="" placeholder="Retype new password">
                      </div>
                    </div>
                    <h3 class="card-title mt-4">Public profile</h3>
                    <p class="card-subtitle">Making your profile public means that anyone on the Dashkit network will be able to find
                      you.</p>
                    <div>
                      <label class="form-check form-switch form-switch-lg">
                        <input class="form-check-input" type="checkbox" >
                        <span class="form-check-label form-check-label-on">You're currently visible</span>
                        <span class="form-check-label form-check-label-off">You're
