                      <a href="#" class="list-group-item list-group-item-action d-flex align-items-center">Billing & Invoices</a>
                    </div>
                    <h4 class="subheader mt-4">Experience</h4>
                    <div class="list-group list-group-transparent">
                      <a href="#" class="list-group-item list-group-item-action">Give Feedback</a>
                    </div>
                  </div>
                </div>
                <div class="col d-flex flex-column">
                  <div class="card-body">
                    <h2 class="mb-4">My Account</h2>
                    <h3 class="card-title">Profile Details</h3>
                    <div class="row align-items-center">
                    
                      <div class="col-auto"><span class="avatar avatar-xl" style="background-image: url(./static/avatars/000m.jpg)"></span>
                      </div>
                      <div class="col-auto">

                      
                          <!-- <label for="image" class="btn">Change avatar</label> -->
                          <input type="file" name="image" id="image" accept="image/*">
                          <button id="uploadBtn">Upload</button>
                   
                      
                      <!-- <a href="#" >
                          
                        </a> -->
                      
                      </div>
                      <div class="col-auto"><a href="#" class="btn btn-ghost-danger">
                          Delete avatar
                        </a></div>
                    </div>


                    <h3 class="card-title mt-4">Business Profile</h3>



                    <div class="row g-3">
                      <div class="col-md">
                        <div class="form-label">Account ID</div>
                        <input type="text" class="form-control" value="<%= data._id %>" disabled>  
                      </div>
                      <div class="col-md">
                        <div class="form-label">First Name</div>
                        <input type="text" class="form-control" value="<%= data.firstname %>" disabled>
                      </div>
                      <div class="col-md">
                        <div class="form-label">Last Name</div>
                        <input type="text" class="form-control"  value="<%= data.lastname %>" disabled> 
                      </div>
                    </div>

<hr />
                                        
                    <div class="row g-3">



                      <div class="col-md">
                        <div class="form-label">Organization role</div>
                        <input type="text" class="form-control" style="text-transform: uppercase;" value="<%= data.role %>" disabled>
                      </div>
                      <div class="col-md">
                        <div class="form-label">Phone number</div>
                        <input type="text" class="form-control" value="<%= data.phonenumber %>" disabled>
                      </div>
                      <div class="col-md">
                        <div class="form-label">Gender</div>
                        <input type="text" class="form-control" value="<%= data.gender %>" disabled>
                      </div>


                      <h3 class="card-title mt-4">Printer Configuration</h3>
                      
                      <div class="col-md">
                        <div class="form-label">Printer serviceUUID</div>
                        <input type="text" id="serviceUUID" class="form-control" value="<%= serviceUUID %>">
                      </div>
                      <div class="col-md">
                        <div class="form-label">Printer characteristicUUID</div>
                        <input type="text" id="characteristicUUID" class="form-control" value="<%= characteristicUUID %>">
                      </div>



                      <div class="col-md">
                        <div style="opacity: 0;" class="form-label">Location</div>
                        <input type="button" id="Updateprinterid" class="form-control btn btn-primary"
             value="Update Printer">
                      </div>

                      <div class="col-md">
                        <div class="form-label">Printer Type</div>
                        <div>
                          <label><input type="radio" name="printerType" value="wireless" id="printerTypeWireless"> Wireless (Bluetooth)</label>
                          <label style="margin-left:20px;"><input type="radio" name="printerType" value="wired" id="printerTypeWired"> Wired</label>
                        </div>
                      </div>
                      <div class="col-md" id="wiredPrinterNameDiv" style="display:none;">
                        <div class="form-label">Wired Printer Name</div>
                        <div class="input-group">
