   <%- include('footer') %>
      </div>
    </div>


<script>
    // Printer type selection logic
    function loadPrinterSettings() {
      const type = localStorage.getItem('printerType') || 'wireless';
      const name = localStorage.getItem('wiredPrinterName') || '';
      document.getElementById('printerTypeWireless').checked = (type === 'wireless');
      document.getElementById('printerTypeWired').checked = (type === 'wired');
      document.getElementById('wiredPrinterSelect').value = name;
      document.getElementById('wiredPrinterNameDiv').style.display = (type === 'wired') ? '' : 'none';
    }
    
    function savePrinterSettings() {
      const type = document.getElementById('printerTypeWireless').checked ? 'wireless' : 'wired';
      localStorage.setItem('printerType', type);
      if (type === 'wired') {
        localStorage.setItem('wiredPrinterName', document.getElementById('wiredPrinterSelect').value);
      }
      // Trigger header update
      window.dispatchEvent(new Event('storage'));
    }
    
    // Load available printers
    // Load available printers
    async function loadAvailablePrinters() {
      try {
        console.log('Fetching printers from /get-printers...');
        const response = await fetch('/get-printers');
        console.log('Response status:', response.status);
        const data = await response.json();
        console.log('Full response data:', data);
        console.log('Printers array:', data.printers);
        console.log('Printers length:', data.printers ? data.printers.length : 'undefined');
        
        const select = document.getElementById('wiredPrinterSelect');
        
        // Clear existing options
        select.innerHTML = '<option value="">Select a printer...</option>';
        
        // Add printers to dropdown
        if (data.printers && data.printers.length > 0) {
          console.log('Adding printers to dropdown...');
          data.printers.forEach((printer, index) => {
            console.log(`Printer ${index}:`, printer);
            const option = document.createElement('option');
            option.value = printer.name || printer.deviceId;
            option.textContent = `${printer.name || printer.deviceId}${printer.paperSizes ? ` (${printer.paperSizes[0]})` : ''}`;
            select.appendChild(option);
          });
        } else {
          console.log('No printers found or empty array');
          select.innerHTML = '<option value="">No printers found</option>';
        }
        
        // Restore saved value
        const savedName = localStorage.getItem('wiredPrinterName') || '';
        if (savedName) {
          select.value = savedName;
        }
      } catch (error) {
        console.error('Error loading printers:', error);
        document.getElementById('wiredPrinterSelect').innerHTML = '<option value="">Error loading printers</option>';
      }
    }

    // New: Web Serial connect helpers for Wired mode
    // Show all serial-capable devices in chooser (broadest compatibility)
    const WEB_SERIAL_VENDOR_FILTERS = [];

    function setWiredStatus(text, ok) {
      const el = document.getElementById('wiredConnectStatus');
      if (!el) return;
      el.textContent = `Status: ${text}`;
      el.style.color = ok ? 'green' : '';
    }

    async function refreshWiredStatusFromPermissions() {
      try {
        if (!('serial' in navigator)) {
          setWiredStatus('Web Serial not supported (use Chrome over HTTPS)', false);
          const btn = document.getElementById('wiredConnectBtn');
          if (btn) btn.disabled = true;
          return;
        }
        const ports = await navigator.serial.getPorts();
        if (ports && ports.length > 0) {
          const info = ports[0].getInfo ? ports[0].getInfo() : {};
          const vid = info.usbVendorId ? info.usbVendorId.toString(16).padStart(4,'0') : '----';
          const pid = info.usbProductId ? info.usbProductId.toString(16).padStart(4,'0') : '----';
          localStorage.setItem('wiredConnected', 'true');
          localStorage.setItem('wiredUsbInfo', JSON.stringify(info));
          setWiredStatus(`Connected (VID: ${vid}, PID: ${pid})`, true);
        } else {
          localStorage.removeItem('wiredConnected');
          localStorage.removeItem('wiredUsbInfo');
          setWiredStatus('Not connected', false);
        }
      } catch (e) {
        console.warn('refreshWiredStatusFromPermissions error', e);
        setWiredStatus('Unknown', false);
      }
    }
    
    async function connectWiredPrinter() {
      try {
        if (!('serial' in navigator)) {
          alert('Web Serial API not supported. Use Chrome over HTTPS.');
          return;
        }
        // Request without filters so Chrome shows all serial-capable devices
        const requestOpts = {};
        if (Array.isArray(WEB_SERIAL_VENDOR_FILTERS) && WEB_SERIAL_VENDOR_FILTERS.length) {
          requestOpts.filters = WEB_SERIAL_VENDOR_FILTERS;
        }
        const port = await navigator.serial.requestPort(requestOpts);
        await port.open({ baudRate: 9600, dataBits: 8, stopBits: 1, parity: 'none', flowControl: 'none' });
        // Immediately close; we just need permission and availability
        await port.close();
        await refreshWiredStatusFromPermissions();
      } catch (e) {
        // Common Chrome messages: "No compatible devices found" or user canceled
        if (e && (e.name === 'NotFoundError' || /No compatible devices/i.test(e.message))) {
          setWiredStatus('No compatible devices found. Ensure USB-Serial driver (e.g., CH340) is installed and try another cable/port.', false);
        } else {
          console.error('connectWiredPrinter error', e);
          setWiredStatus(`Failed: ${e && e.message ? e.message : 'Unknown error'}`, false);
        }
      }
    }
    
    document.addEventListener('DOMContentLoaded', function() {
      loadPrinterSettings();
      loadAvailablePrinters(); // Load printers on page load
      
      document.getElementById('printerTypeWireless').addEventListener('change', function() {
        document.getElementById('wiredPrinterNameDiv').style.display = 'none';
        savePrinterSettings();
      });
      
      document.getElementById('printerTypeWired').addEventListener('change', function() {
        document.getElementById('wiredPrinterNameDiv').style.display = '';
        savePrinterSettings();
        loadAvailablePrinters(); // Reload printers when switching to wired mode
        // Initialize Web Serial status when switching to wired
        setTimeout(refreshWiredStatusFromPermissions, 50);
      });
      
      document.getElementById('wiredPrinterSelect').addEventListener('change', savePrinterSettings);
      
      document.getElementById('refreshPrintersBtn').addEventListener('click', loadAvailablePrinters);

      // Wire up Connect button and initial status
      const connectBtn = document.getElementById('wiredConnectBtn');
      if (connectBtn) {
        connectBtn.addEventListener('click', connectWiredPrinter);
      }
      if ((localStorage.getItem('printerType') || 'wireless') === 'wired') {
        refreshWiredStatusFromPermissions();
      }
    });
    
    $(document).ready(function() {
      $('#uploadBtn').click(function(event) {
          var fileInput = $('#image')[0];
          var file = fileInput.files[0];
          
          if (!file) {
              alert('Please select an image to upload.');
              return;
          }

          var reader = new FileReader();
          reader.onload = function() {
              var imageData = reader.result;
              uploadImage(imageData);
          }
          reader.readAsDataURL(file);
      });

      function uploadImage(imageData) {
          $.ajax({
              url: '/upload',
              type: 'POST',
              data: { image: imageData },
              success: function(response) {
                  console.log(response);
                  alert('Image uploaded successfully!');
              },
              error: function(xhr, status, error) {
                  console.error(xhr.responseText);
                  alert('Error uploading image. Please try again.');
              }
          });
      }
    });
</script>
    <!-- Libs JS -->
